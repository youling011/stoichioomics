{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stoichioomics external data release",
  "type": "object",
  "required": ["schema_version", "release_id", "status", "required_components", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["not_published", "published"]},
    "required_components": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "component", "kind", "filename", "url", "bytes", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "component": {"type": "string", "minLength": 1},
          "kind": {"enum": ["postgres-custom", "tar"]},
          "filename": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "unpacked_bytes": {"type": "integer", "minimum": 1}
        },
        "allOf": [{"if": {"properties": {"kind": {"const": "tar"}}}, "then": {"required": ["unpacked_bytes"]}}]
      }
    }
  }
}
