# Copy to .env outside version control and replace every __REQUIRED_ value.
POSTGRES_DB=stoichioomics
POSTGRES_USER=stoichioomics
POSTGRES_PASSWORD=__REQUIRED_PRIVATE_DATABASE_PASSWORD__
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=5
DJANGO_DB_ENGINE=postgresql
DJANGO_SECRET_KEY=__REQUIRED_RANDOM_SECRET_AT_LEAST_50_CHARACTERS__
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
# Local loopback HTTP only. For public HTTPS follow deploy/README.md.
STOICH_ALLOW_HTTP_TEST=1
DJANGO_SECURE_HSTS_SECONDS=0
HVG_RESEARCH_ENABLED=1
STOICH_LOCAL_READ_ONLY=0
STOICH_WINDOWS_PATH_MAPPINGS={}
STOICH_DATA_HOST_ROOT=__REQUIRED_ABSOLUTE_EXTERNAL_DATA_ROOT__
STOICH_HTTP_BIND=127.0.0.1
STOICH_PUBLIC_PORT=18080
STOICH_NGINX_PORT=18080
STOICH_NGINX_SITE=./deploy/docker/nginx-http.conf
STOICH_NETWORK_NAME=stoichioomics-reproduction
STOICH_NETWORK_EXTERNAL=false
STOICH_APP_MEMORY=4g
STOICH_APP_CPUS=2
