# Copy to .env in the repository root and set private local values.
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=stoichioomics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_PRIVATE_DJANGO_SECRET_KEY
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
STOICH_FEATURE_EXTRACTOR_ROOT=tools/feature_extractors
