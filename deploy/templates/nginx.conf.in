# Standalone validation config. Production may include nginx-site.conf in its vendor nginx.conf.
user @NGINX_USER@ @NGINX_GROUP@;
worker_processes 1;
pid /tmp/stoichioomics-nginx.pid;
error_log /var/log/nginx/stoichioomics-main-error.log warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    log_format stoich_timing '$request_id $request_method $uri $status bytes=$body_bytes_sent request=$request_time upstream=$upstream_response_time gzip=$gzip_ratio';
    include "@OUTPUT_ROOT@/nginx-site.conf";
}
