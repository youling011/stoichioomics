# Copy outside the repository; chmod 600. Values are placeholders, not credentials.
DJANGO_SETTINGS_MODULE=backend.config.settings_production
DJANGO_ENV_FILE=
DJANGO_SECRET_KEY=__REQUIRED_RANDOM_SECRET_AT_LEAST_50_CHARACTERS__
DJANGO_ALLOWED_HOSTS=__REQUIRED_DOMAIN__
DJANGO_CSRF_TRUSTED_ORIGINS=https://__REQUIRED_DOMAIN__
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=__REQUIRED_DATABASE__
POSTGRES_USER=__REQUIRED_APP_ROLE__
POSTGRES_PASSWORD=__REQUIRED_PASSWORD__
POSTGRES_HOST=__REQUIRED_DB_HOST__
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_CONN_MAX_AGE=60
# POSTGRES_SSLMODE=verify-full
STOICH_ALLOW_HTTP_TEST=0
DJANGO_SECURE_HSTS_SECONDS=0
# Explicitly preserve this feature from the source project's current .env.
HVG_RESEARCH_ENABLED=1
# Fill using existing feature flags; do not disable analysis as a deployment shortcut.
# Each optional root must be an absolute target-OS path. Defaults retain proj layout.
# STATIC_ROOT=/srv/stoichioomics/proj/staticfiles
# STOICHDB_DATA_ROOT=/srv/stoichioomics/proj/data/stoichdb_demo
# STOICH_FEATURE_ROOT=/srv/stoichioomics/全组学特征数据
# STOICH_FEATURE_EXTRACTOR_ROOT=/srv/stoichioomics/项目平台数据/组学化学计量特征提取代码
# STOICHIOOMICS_ROOT=/srv/stoichioomics
# WORKSPACE_ROOT=/srv/stoichioomics/proj/workspace/jobs
