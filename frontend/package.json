{
  "name": "stoichioomics-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test:proteome": "node --test tests/proteome/proteomeCharts.test.mjs tests/proteome/proteomeContracts.test.mjs",
    "test:proteome:e2e": "playwright test --config playwright.proteome.config.mjs",
    "test:integration": "node --test tests/integration/integrationCharts.test.mjs",
    "test:scientific": "node --test tests/proteome/proteomeCharts.test.mjs tests/proteome/proteomeContracts.test.mjs tests/sequence/sequenceCharts.test.mjs tests/integration/integrationCharts.test.mjs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "echarts": "^5.5.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.0"
  }
